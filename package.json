{
  "name": "calm-contraction-timer",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "check:spdx": "node scripts/check-spdx.mjs",
    "licenses:check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;Python-2.0;CC-BY-4.0;CC0-1.0;Unlicense\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:spdx && npm run test:ci",
    "db:generate": "drizzle-kit generate",
    "postinstall": "node scripts/generate-licences.mjs",
    "licenses:generate": "node scripts/generate-licences.mjs",
    "brand:render": "node scripts/render-brand.mjs"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^19.0.5",
    "@react-native-documents/picker": "^12.1.0",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "drizzle-orm": "^0.45.4",
    "i18next": "^27.2.2",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-blob-util": "^1.1.1",
    "react-native-gifted-charts": "^1.4.83",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-iap": "^17.4.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-notify-kit": "^10.10.1",
    "react-native-paper": "^5.15.5",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.16.1",
    "tslib": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/sql.js": "^1.16.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "jest": "^29.6.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.10.1",
    "sql.js": "^1.17.0",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "description": "The calmest, fastest contraction timer for labour. All data stays on your device.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raman0925/calm-contraction-timer.git"
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "src/core/native",
    "android": {
      "javaPackageName": "com.calmcontractiontimer.app.specs"
    }
  }
}
